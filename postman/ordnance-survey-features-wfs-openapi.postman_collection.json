                        {
                          "description": "The format the response will be returned in. Default: XML.",
                          "key": "outputFormat",
                          "value": "GML32"
                        },
                        {
                          "description": "Type of the results. Default: results.",
                          "key": "resultType",
                          "value": "results"
                        },
                        {
                          "description": "Allows the user to reproject the selected features into another CRS. Default: EPSG:27700",
                          "key": "srsName",
                          "value": "EPSG:27700"
