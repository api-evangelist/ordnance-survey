                      "raw": "{{baseUrl}}/wfs/archive/:year?request=GetFeature&service=WFS&version=2.0.0&typeNames=ITN_UrbanPaths_PathLink&bbox=<string>&filter=<string>&count=100&maxFeatures=100&propertyName=<string>&startIndex=0&outputFormat=GML32&resultType=results&srsName=EPSG:27700",
