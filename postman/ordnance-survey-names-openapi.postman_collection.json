  "item": [
    {
      "name": "find",
      "item": [
        {
          "name": "A free string text search, intended to be an ambiguous/fuzzy search.",
          "id": "46e78f63-5732-4cde-985e-003b81bac77f",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/find?query=<string>&format=XML&maxresults=<integer>&offset=<integer>&bounds=<number>,<number>,<number>,<number>&fq=Bus_Station",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "find"
              ],
              "query": [
                {
                  "description": "(Required) Free text search parameter.",
                  "key": "query",
                  "value": "<string>"
                },
                {
                  "description": "The format the response will be returned in.",
                  "key": "format",
                  "value": "XML"
                },
                {
                  "description": "The maximum number of results to return. Minimum = 1. Maximum = 100. Default = 100.",
                  "key": "maxresults",
                  "value": "<integer>"
                },
                {
                  "description": "Offset the list of returned results by this amount.",
                  "key": "offset",
                  "value": "<integer>"
                },
                {
                  "description": "Biases the results to a certain area. The <BoundingBox> is a British National Grid bounding box in the form: XMIN,YMIN,XMAX,YMAX",
                  "key": "bounds",
                  "value": "<number>,<number>,<number>,<number>"
                },
                {
                  "description": "Filters the results by bounding box or local_type. ",
                  "key": "fq",
                  "value": "Bus_Station"
                }
              ]
            }
          },
          "response": [
            {
